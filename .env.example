# DATABASE
MONGODB_URI=mongodb://ID:PASSWORD@IP:PORT/DATABASE?authSource=admin

MARIADB_URL=jdbc:mysql://localhost:3306/factory-tycoon
MARIADB_USERNAME=user
MARIADB_PASSWORD=password

# Redis Configuration
REDIS_HOST=IP_ADDRESS
REDIS_PORT=port
REDIS_PASSWORD=password

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-this-in-production-min-256-bits
JWT_ACCESS_TTL_MS=3600000
JWT_REFRESH_TTL_MS=86400000

# OpenSearch Configuration

OPENSEARCH_ENDPOINT=your-opensearch-endpoint

OPENSEARCH_REGION=your-opensearch-region



# AWS Credentials for local development

AWS_ACCESS_KEY_ID=your-aws-access-key-id

AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key




